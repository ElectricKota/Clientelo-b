---
import { etfs, categories, fmt, data, policyLabel } from '../data/etfs';

const present = categories.filter((c) => etfs.some((e) => e.category === c.id));
// Filtrování řeší čisté CSS přes :has(), JavaScript jen oznamuje počet výsledků čtečkám.
const filterCss = present
  .map((c) => `.etf-compare:has(input[value="${c.id}"]:checked) .etf-card:not([data-cat="${c.id}"]){display:none}`)
  .join('');
const issuerHost = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<style is:inline set:html={filterCss}></style>

<section id="porovnani" data-section="compare" aria-labelledby="compare-title" class="scroll-mt-4 bg-sand/60 py-16 sm:py-24">
  <div class="container-page etf-compare">
    <div class="max-w-3xl">
      <p class="eyebrow">Porovnání fondů</p>
      <h2 id="compare-title" class="mt-3 text-3xl leading-tight sm:text-5xl">{etfs.length} nejpopulárnějších ETF z NYSE. A jejich evropská dvojčata.</h2>
      <p class="mt-4 text-lg text-ink-soft">
        U každého fondu vidíte poplatek, velikost a výnos podle emitenta. Pod ním najdete evropskou (UCITS) obdobu, kterou si z Česka opravdu koupíte.
      </p>
    </div>

    <fieldset class="mt-8">
      <legend class="sr-only">Filtrovat podle typu fondu</legend>
      <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-2 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:px-0">
        {
          [{ id: 'all', label: 'Vše' }, ...present].map((c) => (
            <label class="shrink-0">
              <input type="radio" name="etf-filter" value={c.id} checked={c.id === 'all'} class="peer sr-only" />
              <span class="flex min-h-11 cursor-pointer items-center rounded-full border border-line bg-surface px-4 text-sm font-semibold whitespace-nowrap peer-checked:border-pine peer-checked:bg-pine peer-checked:text-white peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus">
                {c.label}
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <p class="sr-only" aria-live="polite" data-count></p>

    <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {
        etfs.map((e) => (
          <li class="etf-card" data-cat={e.category}>
            <article class="card flex h-full flex-col p-6" aria-labelledby={`etf-${e.ticker}`}>
              <header class="flex items-start justify-between gap-3">
                <div>
                  <h3 id={`etf-${e.ticker}`} class="font-serif text-3xl leading-none">
                    {e.ticker}
                  </h3>
                  <p class="mt-2 text-sm text-ink-soft">
                    {e.name}
                    {e.formerTicker && ` (dříve ${e.formerTicker})`}
                  </p>
                </div>
                <span class="shrink-0 rounded-full bg-sand px-3 py-1 text-xs font-semibold">{categories.find((c) => c.id === e.category)?.label}</span>
              </header>

              <dl class="num mt-5 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
                <div>
                  <dt class="text-ink-soft">
                    <abbr title="Celková roční nákladovost fondu" class="no-underline">
                      TER
                    </abbr>{' '}
                    ročně
                  </dt>
                  <dd class="text-base font-semibold">{fmt.ter(e.ter)}</dd>
                </div>
                <div>
                  <dt class="text-ink-soft">Majetek fondu</dt>
                  <dd class="text-base font-semibold">{fmt.usdBn(e.aumUsd)}</dd>
                </div>
                <div>
                  <dt class="text-ink-soft">Výnos 5 let (p. a.)</dt>
                  <dd class="text-base font-semibold">{fmt.pct(e.returns.y5)}</dd>
                </div>
                <div>
                  <dt class="text-ink-soft">{e.category === 'gold' ? 'Výnos 10 let (p. a.)' : 'Dividendový výnos'}</dt>
                  <dd class="text-base font-semibold">{e.category === 'gold' ? fmt.pct(e.returns.y10) : `${e.yield.estimate ? '≈ ' : ''}${fmt.pct(e.yield.value)}`}</dd>
                </div>
              </dl>

              <div class="mt-5 rounded-2xl bg-mint/70 p-4">
                <p class="text-xs font-semibold tracking-wide text-gain uppercase">Z Česka koupíte</p>
                <ul class="mt-2 space-y-2">
                  {e.ucits.map((u) => (
                    <li class="text-sm">
                      <span class="font-semibold text-ink">{u.ticker}</span>
                      <span class="num text-ink-soft">
                        {' '}
                        · TER {fmt.ter(u.ter)} · {policyLabel(u.policy)}
                      </span>
                      <span class="block text-xs text-ink-soft">
                        {u.exactMatch ? '' : 'Nejbližší obdoba. '}
                        {u.note}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-auto pt-5">
                <a
                  href="#formular"
                  class="link inline-flex min-h-11 items-center gap-1 text-sm"
                  data-track="cta_click"
                  data-placement="card"
                  data-label={e.ticker}
                >
                  Jak ho najít u brokera a jak se daní<span aria-hidden="true"> →</span>
                  <span class="sr-only">: {e.ticker}</span>
                </a>
                <p class="mt-2 text-xs text-ink-soft">
                  Zdroj:{' '}
                  <a href={e.sourceUrl} class="inline-flex min-h-6 items-center underline underline-offset-2" rel="noopener" target="_blank">
                    {issuerHost(e.sourceUrl)}
                    <span class="sr-only"> (otevře se v novém okně)</span>
                  </a>
                  , výnosy k {fmt.date(e.returns.asOf)}
                </p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 max-w-3xl text-sm text-ink-soft">
      Data podle emitentů fondů, evropské fondy podle justETF. Výnosy jsou průměrné roční celkové výnosy (včetně dividend) v USD z čisté hodnoty aktiv k
      {fmt.date(data.asOf)}. Dividendový výnos je 30denní SEC yield; u fondů se znaménkem ≈ ho Vanguard neuvádí a jde o náš odhad z vyplacených dividend za 12
      měsíců. Poplatky jsou podle prospektu. Minulé výnosy nejsou zárukou budoucích a výnos v korunách ovlivňuje kurz USD/CZK.
    </p>
  </div>
</section>

<script>
  import { track } from '../scripts/track';

  const root = document.querySelector('.etf-compare');
  const count = root?.querySelector('[data-count]');
  root?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.name !== 'etf-filter') return;
    const visible = [...root.querySelectorAll<HTMLElement>('.etf-card')].filter((el) => el.offsetParent !== null).length;
    if (count) count.textContent = `Zobrazeno ${visible} ${visible === 1 ? 'fond' : visible < 5 ? 'fondy' : 'fondů'}.`;
    track('filter_change', { category: input.value });
  });
</script>
