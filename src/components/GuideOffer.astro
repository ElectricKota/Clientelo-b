---
import LeadForm from './LeadForm.astro';
import { etfs } from '../data/etfs';

const chapters = [
  {
    title: 'Převodník NYSE → Evropa',
    text: `Všech ${etfs.length} ETF s jejich UCITS obdobou: ticker, burza, ISIN a poplatek. Stačí přepsat do aplikace brokera.`,
  },
  {
    title: 'Jak fond najít u brokera',
    text: 'Postup pro XTB, Trading 212, Degiro, Interactive Brokers a Fio: hledání podle ISIN, správná burza a měna, na co si dát pozor u poplatků.',
  },
  {
    title: 'Daně bez stresu',
    text: 'Časový test, limit 100 000 Kč, formulář W-8BEN a rozdíl mezi akumulační a distribuční třídou na jedné straně.',
  },
  {
    title: '5 chyb začátečníků',
    text: 'Dva fondy na stejný index, honba za dividendou, zbytečná směna měny a další omyly, které stojí peníze.',
  },
];
---

<section id="formular" data-section="offer" aria-labelledby="offer-title" class="scroll-mt-4 py-16 sm:py-24">
  <div class="container-page">
    <div class="overflow-hidden rounded-[2rem] bg-pine text-white">
      <div class="grid gap-10 p-6 sm:p-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14 lg:p-14">
        <div>
          <p class="text-sm font-semibold tracking-wide text-[#f4b393] uppercase">ETF tahák 2026 · PDF zdarma</p>
          <h2 id="offer-title" class="mt-3 text-3xl leading-tight text-white sm:text-5xl">Všechno podstatné na 8 stranách. Za 10 minut máte jasno.</h2>

          <ol class="mt-8 grid gap-6 sm:grid-cols-2">
            {
              chapters.map((c, i) => (
                <li class="flex gap-4">
                  <span class="num grid size-9 shrink-0 place-items-center rounded-full bg-white/10 font-serif text-lg" aria-hidden="true">
                    {i + 1}
                  </span>
                  <div>
                    <h3 class="font-sans text-base font-semibold text-white">{c.title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-white/80">{c.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <div class="mt-10 max-w-xl">
            <LeadForm placement="offer" button="Poslat tahák zdarma" tone="dark" />
          </div>
        </div>

        <figure class="relative mx-auto hidden w-full max-w-sm sm:block" aria-hidden="true">
          <div class="absolute inset-0 translate-x-4 translate-y-4 rotate-3 rounded-2xl bg-white/15"></div>
          <div class="relative rounded-2xl bg-paper p-6 text-ink shadow-2xl">
            <div class="flex items-center justify-between text-xs text-ink-soft">
              <span class="font-semibold text-pine">ETF tahák 2026</span><span>strana 2</span>
            </div>
            <p class="mt-4 font-serif text-2xl leading-tight text-pine">Převodník NYSE → Evropa</p>
            <table class="num mt-4 w-full text-left text-xs">
              <thead class="text-ink-soft">
                <tr><th class="pb-2 font-normal">NYSE</th><th class="pb-2 font-normal">UCITS</th><th class="pb-2 text-right font-normal">TER</th></tr>
              </thead>
              <tbody>
                {
                  etfs.slice(0, 7).map((e) => (
                    <tr class="border-t border-line">
                      <td class="py-2 font-semibold">{e.ticker}</td>
                      <td class="py-2">{e.ucits[0]?.primary}</td>
                      <td class="py-2 text-right">{e.ucits[0] ? `${e.ucits[0].ter.toLocaleString('cs-CZ')} %` : ''}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <div class="mt-4 space-y-2" aria-hidden="true">
              <div class="h-2 w-11/12 rounded bg-sand"></div>
              <div class="h-2 w-9/12 rounded bg-sand"></div>
              <div class="h-2 w-10/12 rounded bg-sand"></div>
            </div>
          </div>
        </figure>
      </div>

      <div class="border-t border-white/10 bg-black/10 px-6 py-6 sm:px-10 lg:px-14">
        <h3 class="sr-only">Co se stane po odeslání</h3>
        <ol class="grid gap-4 text-sm text-white/85 sm:grid-cols-3">
          <li><strong class="text-white">1. Hned:</strong> PDF si stáhnete přímo na další stránce, nic nečekáte.</li>
          <li><strong class="text-white">2. Do minuty:</strong> do e-mailu přijde odkaz na tahák a váš výpočet z kalkulačky.</li>
          <li><strong class="text-white">3. Jednou za čtvrtletí:</strong> aktualizovaná data. Odhlášení jedním kliknutím.</li>
        </ol>
      </div>
    </div>
  </div>
</section>
