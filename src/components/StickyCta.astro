---
// Lišta pro mobil: zobrazí se po opuštění hero sekce a zmizí, když je formulář na obrazovce.
---

<sticky-cta class="pointer-events-none fixed inset-x-0 bottom-0 z-30 block p-3 sm:hidden">
  <div
    data-bar
    class="pointer-events-auto flex translate-y-[130%] items-center gap-3 rounded-full bg-pine/95 py-2 pr-2 pl-5 text-white shadow-2xl backdrop-blur transition-transform duration-300 data-[shown]:translate-y-0"
    inert
  >
    <p class="flex-1 text-sm leading-tight font-semibold">ETF tahák 2026<span class="block font-normal text-white/75">PDF zdarma</span></p>
    <a href="#formular" class="btn btn-primary min-h-11 px-5 text-sm" data-track="cta_click" data-placement="sticky" data-label="form">Chci tahák</a>
  </div>
</sticky-cta>

<script>
  class StickyCta extends HTMLElement {
    connectedCallback() {
      const bar = this.querySelector<HTMLElement>('[data-bar]')!;
      const hero = document.querySelector('[data-section="hero"]');
      const forms = document.querySelectorAll('lead-form');
      const state = { pastHero: false, formVisible: new Set<Element>() };

      const render = () => {
        const show = state.pastHero && state.formVisible.size === 0;
        bar.toggleAttribute('data-shown', show);
        bar.inert = !show;
      };

      if (hero) {
        new IntersectionObserver(([entry]) => {
          state.pastHero = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          render();
        }).observe(hero);
      }
      const formIo = new IntersectionObserver((entries) => {
        for (const entry of entries) entry.isIntersecting ? state.formVisible.add(entry.target) : state.formVisible.delete(entry.target);
        render();
      });
      forms.forEach((f) => formIo.observe(f));
    }
  }
  customElements.define('sticky-cta', StickyCta);
</script>
