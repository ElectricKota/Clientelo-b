---
// Reklama B „Chat“: nativně vypadající konverzace (obecný vzhled chatu, bez značky konkrétní aplikace).
// Hook = frustrace, kterou cílovka zná („broker mi VOO nenajde“), a hned řešení.
import { etfs } from '~/data/etfs';
import { format } from '~/utils/format';
import BaseIcon from '~/components/base/BaseIcon.astro';

interface Props {
  isStory: boolean;
}

type ChatMessage = { from: 'friend' | 'me'; text: string } | { from: 'me'; fundCard: true } | { from: 'friend'; isTyping: true };

const { isStory } = Astro.props;
const europeanFund = etfs.find((etf) => etf.ticker === 'VOO')!.ucits[0];

const messages: ChatMessage[] = [
  { from: 'friend', text: 'Proč mi broker nenajde VOO? 🤨' },
  { from: 'me', text: 'Z EU ho jako drobnej investor nekoupíš. Regulace PRIIPs.' },
  { from: 'me', text: 'Kup VUAA. Stejnej S&P 500, jen evropská verze 👇' },
  { from: 'me', fundCard: true },
  { from: 'friend', text: 'A SCHD? VT? 😅' },
  { from: 'me', text: 'Tady máš tahák na všech 10 👇' },
  { from: 'friend', isTyping: true },
];
---

<div class:list={['relative flex h-full flex-col bg-[#efeae2] text-ink', isStory && 'pt-[200px] pb-[300px]']}>
  <header class:list={['flex items-center gap-6 border-b border-black/5 bg-white/80 px-14', isStory ? 'py-8' : 'py-6']}>
    <BaseIcon name="back" size={30} strokeWidth={2.4} class="text-ink" />
    <span class="grid size-[84px] place-items-center rounded-full bg-[#c9d8d2] text-[36px] font-semibold text-pine">H</span>
    <div class="leading-tight">
      <p class="text-[36px] font-semibold">Honza</p>
      <p class="text-[26px] text-ink-soft">online</p>
    </div>
  </header>

  <ul class:list={['flex min-h-0 flex-1 flex-col overflow-hidden', isStory ? 'gap-5 px-14 pt-12' : 'gap-4 px-12 pt-8']}>
    {
      messages.map((message) =>
        'isTyping' in message ? (
          <li class="flex justify-start" aria-hidden="true">
            <span class="flex gap-2.5 rounded-[38px] rounded-tl-lg bg-white px-8 py-7">
              <span class="size-4 rounded-full bg-ink/30" />
              <span class="size-4 rounded-full bg-ink/45" />
              <span class="size-4 rounded-full bg-ink/30" />
            </span>
          </li>
        ) : 'fundCard' in message ? (
          <li class="flex justify-end">
            <div class:list={['w-[640px] rounded-[34px] rounded-tr-lg bg-white shadow-[0_2px_0_rgb(0_0_0/0.06)]', isStory ? 'p-7' : 'px-7 py-6']}>
              <div class="flex items-start justify-between">
                <p class:list={['font-serif leading-none text-pine', isStory ? 'text-[76px]' : 'text-[64px]']}>{europeanFund.primary}</p>
                <span class="rounded-full bg-mint px-5 py-1.5 text-[24px] font-semibold text-gain">UCITS</span>
              </div>
              <p class="mt-3 text-[25px] leading-snug text-ink-soft">{europeanFund.name}</p>
              <p class="num mt-4 flex gap-3 text-[25px]">
                <span class="rounded-full bg-sand px-4 py-1">S&amp;P 500</span>
                <span class="rounded-full bg-sand px-4 py-1">TER {format.ter(europeanFund.ter)}</span>
              </p>
            </div>
          </li>
        ) : (
          <li class:list={['flex', message.from === 'me' ? 'justify-end' : 'justify-start']}>
            <p
              class:list={[
                'max-w-[780px] px-9 leading-snug shadow-[0_2px_0_rgb(0_0_0/0.06)]',
                isStory ? 'py-6 text-[38px]' : 'py-5 text-[37px]',
                message.from === 'me' ? 'rounded-[38px] rounded-tr-lg bg-[#d6eadf]' : 'rounded-[38px] rounded-tl-lg bg-white',
              ]}
            >
              {message.text}
            </p>
          </li>
        ),
      )
    }
  </ul>

  <footer class:list={['flex shrink-0 items-center justify-between gap-6 bg-pine text-white', isStory ? 'mx-14 rounded-[48px] px-10 py-8' : 'mt-6 px-12 py-8']}>
    <div>
      <p class="font-serif text-[40px] leading-tight">Co koupit místo VOO?</p>
      <p class="mt-1 text-[19px] text-white/60">Ilustrační konverzace. Nejde o investiční doporučení.</p>
    </div>
    <span class="grid size-[96px] shrink-0 place-items-center rounded-full bg-brick">
      <BaseIcon name="arrow-right" size={42} strokeWidth={2.2} />
    </span>
  </footer>
</div>
