---
// Reklama A „Účtenka“: hook = konkrétní číslo ztráty (averze ke ztrátě),
// účtenka na tmavém pozadí vizuálně vybočí z feedu. Stejná účtenka je v hero varianty A.
import { appConfig } from '~/app.config';
import { calculatorDefaults } from '~/data/etfs';
import { feeCost } from '~/utils/finance';
import { format } from '~/utils/format';
import AppLogo from '~/components/app/AppLogo.astro';
import BaseIcon from '~/components/base/BaseIcon.astro';
import EtfReceipt from '~/components/etf/EtfReceipt.astro';

interface Props {
  isStory: boolean;
}

const { isStory } = Astro.props;
const { initial, monthly, years, annualReturn, customTer } = calculatorDefaults;
const hiddenFeeCost = feeCost({ initial, monthly, years, annualReturn, ter: customTer });
---

<div class:list={['relative flex h-full flex-col overflow-hidden bg-pine text-white', isStory ? 'px-[84px] pt-[250px] pb-[340px]' : 'px-[76px] pt-[64px] pb-[56px]']}>
  <div class="absolute -top-56 -left-40 size-[760px] rounded-full bg-[#1d5c51] opacity-60 blur-3xl" aria-hidden="true"></div>
  <div class="absolute -right-48 bottom-24 size-[620px] rounded-full bg-brick opacity-25 blur-3xl" aria-hidden="true"></div>

  <h1 class="relative font-serif leading-[0.95] font-medium tracking-tight text-white">
    <span class:list={['num block text-[#f4b393]', isStory ? 'text-[168px]' : 'text-[150px]']}>{format.czk(hiddenFeeCost)}</span>
    <span class:list={['mt-4 block leading-[1.05]', isStory ? 'text-[80px]' : 'text-[66px]']}>
      za {years} let. <em class="text-[#f4b393]">A ani o tom nevíte.</em>
    </span>
  </h1>

  <div class:list={['relative mx-auto w-full max-w-[900px]', isStory ? 'mt-20' : 'mt-12']}>
    <EtfReceipt size={isStory ? '32px' : '30px'} class="-rotate-2" />
  </div>

  <footer class="relative mt-auto flex items-end justify-between gap-8">
    <div>
      <p class="flex items-center gap-3 font-serif text-[34px] font-semibold">
        <AppLogo size={44} tone="inverted" />
        {appConfig.brand}
      </p>
      <p class="mt-3 max-w-[520px] text-[17px] leading-snug text-white/60">Modelový výpočet, TER dle emitentů. Nejde o investiční doporučení.</p>
    </div>
    <span class="flex shrink-0 items-center gap-4 rounded-full bg-brick py-5 pr-6 pl-9 text-[32px] font-semibold">
      Spočítat svou účtenku
      <BaseIcon name="arrow-right" size={34} strokeWidth={2.2} />
    </span>
  </footer>
</div>
