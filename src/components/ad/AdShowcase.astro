---
// Jedna reklama na přehledové stránce: náhled ve feedu, stories, navazující první obrazovka, texty a URL s UTM.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { buildAdUrl, type Ad } from '~/data/ads';
import AdFeedPreview from '~/components/ad/AdFeedPreview.astro';
import BaseIcon from '~/components/base/BaseIcon.astro';

interface Props {
  ad: Ad;
  images: { feed: ImageMetadata; story: ImageMetadata; landing: ImageMetadata };
}

const { ad, images } = Astro.props;
const url = buildAdUrl(ad, Astro.site!);
---

<section class:list={['py-14 sm:py-20', ad.id === 'b' && 'bg-sand/60']} aria-labelledby={`ad-${ad.id}`}>
  <div class="container-page">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Reklama {ad.id.toUpperCase()}</p>
      <h2 id={`ad-${ad.id}`} class="mt-2 text-3xl leading-tight sm:text-5xl">
        {ad.name}
      </h2>
      <p class="mt-3 text-lg text-ink-soft">{ad.angle}</p>
    </div>

    <div class="mt-10 grid items-start gap-8 md:grid-cols-2 xl:grid-cols-[minmax(0,5fr)_minmax(0,3fr)_minmax(0,3fr)]">
      <AdFeedPreview ad={ad} feedImage={images.feed} />

      <figure class="reveal" aria-label={`Reklama ${ad.id.toUpperCase()} ve formátu stories`}>
        <Image src={images.story} alt={`Vizuál reklamy ${ad.id.toUpperCase()} ve formátu 9:16 pro stories`} widths={[300, 540]} sizes="(min-width: 1280px) 320px, (min-width: 768px) 50vw, 100vw" class="mx-auto w-full max-w-xs rounded-[1.75rem] border border-line shadow-(--shadow-card)" loading="lazy" />
        <figcaption class="mt-3 text-center text-sm text-ink-soft">Stories a Reels, 1080 × 1920</figcaption>
      </figure>

      <figure class="reveal md:col-span-2 xl:col-span-1" aria-label={`První obrazovka stránky ${ad.landingPath} na mobilu`}>
        <div class="mx-auto w-full max-w-xs rounded-[2.25rem] border-[10px] border-ink bg-ink shadow-(--shadow-card)">
          <Image src={images.landing} alt={`První obrazovka stránky ${ad.landingPath} na mobilu`} widths={[300, 600]} sizes="320px" class="w-full rounded-[1.6rem]" loading="lazy" />
        </div>
        <figcaption class="mt-3 text-center text-sm text-ink-soft">
          Navazuje: <a class="link" href={ad.landingPath}>{ad.landingPath}</a>
        </figcaption>
      </figure>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-2">
      <div class="reveal">
        <h3 class="font-sans text-lg font-semibold">Jak navazuje první obrazovka</h3>
        <ul class="mt-4 space-y-3">
          {ad.messageMatch.map((point) => (
            <li class="flex gap-3">
              <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-mint text-gain"><BaseIcon name="check" size={14} strokeWidth={2.2} /></span>
              <span class="text-ink-soft">{point}</span>
            </li>
          ))}
        </ul>
        <h3 class="mt-8 font-sans text-lg font-semibold">Hypotéza</h3>
        <p class="mt-2 text-ink-soft">{ad.hypothesis}</p>
      </div>

      <div class="reveal">
        <h3 class="font-sans text-lg font-semibold">Texty a odkaz</h3>
        <dl class="mt-4 grid grid-cols-2 gap-4 text-sm">
          <div class="col-span-2">
            <dt class="text-ink-soft">Primární text</dt>
            <dd class="mt-1 text-base whitespace-pre-line">{ad.primaryText}</dd>
          </div>
          <div>
            <dt class="text-ink-soft">Nadpis</dt>
            <dd class="mt-1 text-base font-semibold">{ad.headline}</dd>
          </div>
          <div>
            <dt class="text-ink-soft">Popis</dt>
            <dd class="mt-1 text-base">{ad.description}</dd>
          </div>
          <div class="col-span-2">
            <dt class="text-ink-soft">Tlačítko</dt>
            <dd class="mt-1 text-base">{ad.cta}</dd>
          </div>
          <div class="col-span-2">
            <dt class="text-ink-soft">Cílová URL s UTM</dt>
            <dd class="mt-1 rounded-xl bg-surface p-3 font-mono text-xs break-all">{url}</dd>
          </div>
        </dl>
        <p class="mt-5 flex flex-wrap gap-3">
          <a class="btn btn-secondary min-h-11 px-5 text-sm" href={images.feed.src} download={`reklama-${ad.id}-feed-1080x1350.png`}>
            Stáhnout feed 4:5
          </a>
          <a class="btn btn-secondary min-h-11 px-5 text-sm" href={images.story.src} download={`reklama-${ad.id}-story-1080x1920.png`}>
            Stáhnout stories 9:16
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
