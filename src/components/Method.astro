---
import { data, fmt } from '../data/etfs';

const points = [
  {
    title: 'Čísla ze zdroje, ne z fór',
    text: 'Poplatky, velikost i výnosy bereme přímo ze stránek emitentů (Vanguard, State Street, iShares, Schwab), evropské fondy z justETF. U každého fondu je odkaz.',
  },
  {
    title: 'Stejná měřítka pro všechny',
    text: 'Porovnáváme celkové výnosy z čisté hodnoty aktiv k jednomu datu. Žádné vybírání období, kdy fond vypadá nejlépe.',
  },
  {
    title: 'Říkáme i nepříjemné věci',
    text: 'Evropská obdoba bývá o pár setin procenta dražší a u některých fondů přesná kopie neexistuje. Píšeme to přímo u nich.',
  },
  {
    title: 'Informace, ne doporučení',
    text: 'Tahák vám pomůže se zorientovat. Nekupujeme za vás a neříkáme, do čeho investovat. Rozhodnutí je vždy na vás.',
  },
];
---

<section data-section="method" aria-labelledby="method-title" class="py-16 sm:py-24">
  <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
    <div class="reveal">
      <p class="eyebrow">Proč tomu věřit</p>
      <h2 id="method-title" class="mt-3 text-3xl leading-tight sm:text-4xl">Jak data sbíráme a ověřujeme</h2>
      <p class="mt-4 text-ink-soft">Poslední aktualizace {fmt.date(data.asOf)}. Další proběhne po konci čtvrtletí, odběratelé taháku ji dostanou e-mailem.</p>
    </div>
    <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2" role="list">
      {
        points.map((p, i) => (
          <li class="reveal border-t-2 border-pine pt-4" style={`--i:${i % 2}`}>
            <h3 class="font-sans text-lg font-semibold">{p.title}</h3>
            <p class="mt-2 text-ink-soft">{p.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
