---
// Číselné pole s vlastními šipkami nahoru/dolů. Bez JS zůstává funkční nativní <input type="number">,
// komponenta přidá tlačítka s přidržením (zrychlující opakování), hlídání mezí a jemnou animaci hodnoty.
interface Props {
  id: string;
  name: string;
  value: number;
  min: number;
  max: number;
  step: number;
  /** Jednotka zobrazená za číslem (např. „% ročně“). */
  unit?: string;
  describedby?: string;
  class?: string;
}

const { id, name, value, min, max, step, unit, describedby, class: className } = Astro.props;
const stepLabel = String(step).replace('.', ',');
---

<number-stepper class:list={['stepper', className]}>
  <input
    id={id}
    name={name}
    type="number"
    inputmode="decimal"
    min={min}
    max={max}
    step={step}
    value={value}
    aria-describedby={describedby}
    class="stepper-input num"
  />
  {unit && <span class="stepper-unit" aria-hidden="true">{unit}</span>}
  <div class="stepper-buttons">
    <button type="button" tabindex="-1" data-dir="1" aria-label={`Zvýšit o ${stepLabel}`} aria-controls={id}>
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none">
        <path d="m4 10 4-4 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button type="button" tabindex="-1" data-dir="-1" aria-label={`Snížit o ${stepLabel}`} aria-controls={id}>
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none">
        <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</number-stepper>

<style is:global>
  number-stepper {
    display: inline-flex;
    align-items: stretch;
    min-height: 3.25rem;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: #fff;
    overflow: hidden;
    transition:
      border-color 0.2s ease,
      box-shadow 0.25s var(--ease-out-soft);
  }

  @media (hover: hover) {
    number-stepper:hover {
      border-color: color-mix(in srgb, var(--color-pine) 45%, transparent);
    }
  }

  /* Fokus kreslíme na celém ovládacím prvku, ne jen na textovém poli uvnitř. */
  number-stepper:has(:focus-visible) {
    border-color: var(--color-pine);
    box-shadow: 0 0 0 4px var(--color-focus-halo);
  }

  .stepper-input {
    width: 4.75rem;
    min-width: 0;
    padding: 0 0.25rem 0 1rem;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: 1.25rem;
    font-weight: 600;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .stepper-input:focus-visible {
    outline: none;
    animation: none;
  }

  .stepper-input::-webkit-inner-spin-button,
  .stepper-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .stepper-unit {
    align-self: center;
    padding-right: 0.875rem;
    color: var(--color-ink-soft);
    font-weight: 600;
    white-space: nowrap;
  }

  .stepper-buttons {
    display: grid;
    grid-template-rows: 1fr 1fr;
    width: 2.75rem;
    border-left: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .stepper-buttons button {
    display: grid;
    place-items: center;
    min-height: 1.5rem;
    color: var(--color-pine);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .stepper-buttons button + button {
    border-top: 1px solid var(--color-line);
  }

  .stepper-buttons button svg {
    transition: transform 0.2s var(--ease-out-soft);
  }

  @media (hover: hover) {
    .stepper-buttons button:hover:not([aria-disabled='true']) {
      background: var(--color-pine);
      color: #fff;
    }

    .stepper-buttons button[data-dir='1']:hover:not([aria-disabled='true']) svg {
      transform: translateY(-2px);
    }

    .stepper-buttons button[data-dir='-1']:hover:not([aria-disabled='true']) svg {
      transform: translateY(2px);
    }
  }

  .stepper-buttons button:active:not([aria-disabled='true']) svg {
    transform: scale(0.8);
  }

  .stepper-buttons button[aria-disabled='true'] {
    color: color-mix(in srgb, var(--color-ink-soft) 40%, transparent);
    cursor: not-allowed;
  }

  /* Bez JS (komponenta nedefinovaná) šipky schováme, funguje nativní pole. */
  number-stepper:not(:defined) .stepper-buttons {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .stepper-input.bump-up {
      animation: stepper-bump-up 0.22s var(--ease-out-soft);
    }

    .stepper-input.bump-down {
      animation: stepper-bump-down 0.22s var(--ease-out-soft);
    }
  }

  @keyframes stepper-bump-up {
    from {
      transform: translateY(6px);
      opacity: 0.4;
    }
  }

  @keyframes stepper-bump-down {
    from {
      transform: translateY(-6px);
      opacity: 0.4;
    }
  }
</style>

<script>
  const HOLD_DELAY = 380;
  const REPEAT_START = 120;
  const REPEAT_MIN = 35;

  class NumberStepper extends HTMLElement {
    input!: HTMLInputElement;
    buttons!: HTMLButtonElement[];
    timer = 0;
    pointerStep = false;

    connectedCallback() {
      this.input = this.querySelector('input')!;
      this.buttons = [...this.querySelectorAll<HTMLButtonElement>('button[data-dir]')];

      for (const button of this.buttons) {
        const dir = Number(button.dataset.dir);
        button.addEventListener('pointerdown', (e) => {
          if (e.button !== 0) return;
          e.preventDefault(); // fokus zůstane v poli, klávesnice dál funguje šipkami
          this.pointerStep = true;
          try {
            button.setPointerCapture(e.pointerId);
          } catch {}
          this.step(dir);
          this.hold(dir, HOLD_DELAY, REPEAT_START);
        });
        for (const type of ['pointerup', 'pointercancel', 'lostpointercapture']) {
          button.addEventListener(type, () => this.stop());
        }
        // Aktivace čtečkou nebo virtuální klik (bez pointerdown).
        button.addEventListener('click', () => {
          if (this.pointerStep) {
            this.pointerStep = false;
            return;
          }
          this.step(dir);
        });
      }

      this.input.addEventListener('input', () => this.sync());
      this.input.addEventListener('change', () => this.clamp());
      this.sync();
    }

    disconnectedCallback() {
      this.stop();
    }

    hold(dir: number, delay: number, interval: number) {
      this.timer = window.setTimeout(() => {
        if (!this.step(dir)) return this.stop();
        this.hold(dir, interval, Math.max(REPEAT_MIN, interval * 0.85));
      }, delay);
    }

    stop() {
      clearTimeout(this.timer);
    }

    /** Posune hodnotu o jeden krok; vrací false, pokud už je na mezi. */
    step(dir: number) {
      const before = this.input.value;
      if (this.input.value === '') this.input.value = this.input.min || '0';
      dir > 0 ? this.input.stepUp() : this.input.stepDown();
      if (this.input.value === before) return false;

      this.input.classList.remove('bump-up', 'bump-down');
      void this.input.offsetWidth; // restart animace
      this.input.classList.add(dir > 0 ? 'bump-up' : 'bump-down');

      this.input.dispatchEvent(new Event('input', { bubbles: true }));
      this.input.dispatchEvent(new Event('change', { bubbles: true }));
      return true;
    }

    clamp() {
      const value = Number(this.input.value);
      if (this.input.value === '' || Number.isNaN(value)) return;
      const min = Number(this.input.min);
      const max = Number(this.input.max);
      if (value < min) this.input.value = String(min);
      if (value > max) this.input.value = String(max);
      this.sync();
    }

    sync() {
      const value = Number(this.input.value);
      const [up, down] = this.buttons;
      up.setAttribute('aria-disabled', String(value >= Number(this.input.max)));
      down.setAttribute('aria-disabled', String(value <= Number(this.input.min)));
    }
  }

  customElements.define('number-stepper', NumberStepper);
</script>
