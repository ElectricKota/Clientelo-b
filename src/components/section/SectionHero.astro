---
import BaseIcon, { type IconName } from '~/components/base/BaseIcon.astro';
import { etfData, etfs, calculatorDefaults } from '~/data/etfs';
import { feeCost } from '~/utils/finance';
import { format } from '~/utils/format';
import EtfReceipt from '~/components/etf/EtfReceipt.astro';

interface Props {
  variant: 'a' | 'b';
}
const { variant } = Astro.props;

const byTicker = (t: string) => etfs.find((e) => e.ticker === t)!;
const spy = byTicker('SPY');
const voo = byTicker('VOO');
const vooUcits = voo.ucits[0];
const base = { initial: calculatorDefaults.initial, monthly: calculatorDefaults.monthly, years: calculatorDefaults.years, annualReturn: calculatorDefaults.annualReturn };
const heroRows = [
  { label: spy.ticker, ter: spy.ter, tone: 'bg-pine' },
  { label: voo.ticker, ter: voo.ter, tone: 'bg-pine' },
  { label: vooUcits.primary, ter: vooUcits.ter, tone: 'bg-gain' },
  { label: 'Fond za 1,5 %', ter: calculatorDefaults.customTer, tone: 'bg-brick' },
].map((r) => ({ ...r, cost: feeCost({ ...base, ter: r.ter }) }));
const custom = heroRows[heroRows.length - 1];
const asOf = format.date(etfData.asOf);

const gains: { title: string; text: string; icon: IconName }[] = [
  {
    title: 'Kalkulačka poplatků',
    text: 'vaše číslo za 30 s',
    icon: 'calculator',
  },
  {
    title: `${etfs.length} ETF z NYSE`,
    text: 'a jejich evropská dvojčata',
    icon: 'arrow-right',
  },
  {
    title: 'PDF tahák',
    text: '8 stran: ISIN, daně, postup',
    icon: 'document',
  },
];
---

<section data-section="hero" aria-labelledby="hero-title" class="relative overflow-hidden pt-4 pb-16 sm:pt-10 sm:pb-24">
  <div class="container-page grid items-center gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
    <div>
      {
        variant === 'a' ? (
          <>
            <p class="eyebrow">Porovnání ETF z NYSE · data k {asOf}</p>
            <h1 id="hero-title" class="mt-4 text-display font-medium">
              <span class="num whitespace-nowrap">{format.czk(custom.cost)}</span> za {calculatorDefaults.years} let. <em class="text-brick not-italic sm:italic">A ani o tom nevíte.</em>
            </h1>
            <p class="mt-5 max-w-xl text-lg text-ink-soft sm:text-xl">
              Tolik může spolknout poplatek fondu {calculatorDefaults.customTer.toLocaleString('cs-CZ')} % ročně. Ve výpisu ho nevidíte. ETF na stejný index stojí zlomek,
              spočítejte si své číslo za 30 vteřin.
            </p>
            {/* Mobil a tablet: stejná účtenka jako v reklamě, hned pod nadpisem (velká je vpravo až na desktopu). */}
            <EtfReceipt compact size="13.5px" class="intro mt-6 max-w-md -rotate-1 lg:hidden" />
          </>
        ) : (
          <>
            <p class="eyebrow">Pro investory z Česka · data k {asOf}</p>
            <h1 id="hero-title" class="mt-4 text-display font-medium">
              VOO si z Česka nekoupíte. <em class="text-brick not-italic sm:italic">Tohle ano.</em>
            </h1>
            <p class="mt-5 max-w-xl text-lg text-ink-soft sm:text-xl">
              Evropská regulace brání drobným investorům kupovat ETF registrovaná v USA. Ukážeme vám {etfs.length} nejpopulárnějších ETF z NYSE a jejich evropská
              dvojčata.
            </p>
            {/* Mobil a tablet: zmenšená verze vizuálu z reklamy (VOO → VUAA) přímo pod nadpisem. */}
            <p class="intro mt-5 flex items-center gap-2 text-sm lg:hidden">
              <span class="flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-2 font-semibold">
                {voo.ticker}
                <span class="rounded-full bg-brick-50 px-2 text-xs text-brick">nekoupíte</span>
              </span>
              <BaseIcon name="arrow-right" size={20} class="shrink-0 text-pine" />
              <span class="flex items-center gap-1.5 rounded-full border border-gain/40 bg-surface px-3 py-2 font-semibold ring-2 ring-mint">
                {vooUcits.primary}
                <span class="rounded-full bg-mint px-2 text-xs text-gain">koupíte</span>
              </span>
            </p>
          </>
        )
      }

      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        {
          variant === 'a' ? (
            <a href="#calculator" class="btn btn-primary" data-track="cta_click" data-placement="hero" data-label="calculator">
              Spočítat svou účtenku
              <BaseIcon name="arrow-right" size={18} />
            </a>
          ) : (
            <a href="#comparison" class="btn btn-primary" data-track="cta_click" data-placement="hero" data-label="compare">
              Ukázat evropská dvojčata
              <BaseIcon name="arrow-right" size={18} />
            </a>
          )
        }
        <a href="#guide" class="btn btn-secondary" data-track="cta_click" data-placement="hero" data-label="form">
          Chci rovnou PDF tahák zdarma
        </a>
      </div>

      <div class="mt-8 max-w-xl rounded-2xl border border-line bg-surface/70 p-4 sm:p-5">
        <p id="hero-gain" class="text-xs font-semibold tracking-wide text-gain uppercase">Co získáte zdarma</p>
        <ul class="mt-3 grid gap-3 text-sm sm:grid-cols-3" aria-labelledby="hero-gain">
          {
            gains.map((gain) => (
              <li class="flex items-start gap-2.5">
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-mint text-gain" aria-hidden="true">
                  <BaseIcon name={gain.icon} size={16} strokeWidth={1.8} />
                </span>
                <span class="leading-snug">
                  <strong class="block text-ink">{gain.title}</strong>
                  <span class="text-ink-soft">{gain.text}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      variant === 'a' ? (
        <div class="intro relative hidden lg:block">
          <EtfReceipt size="16px" class="-rotate-2" />
          <p class="mt-6 text-center text-sm text-ink-soft">
            {vooUcits.primary} je evropská obdoba {voo.ticker}, kterou koupíte u evropských brokerů.
          </p>
        </div>
      ) : (
        <figure class="intro relative hidden gap-3 lg:grid" aria-labelledby="hero-fig-cap-b">
          <figcaption id="hero-fig-cap-b" class="sr-only">
            Srovnání {voo.ticker} a jeho evropské obdoby {vooUcits.primary}
          </figcaption>
          <div class="card p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-serif text-3xl text-pine">{voo.ticker}</p>
                <p class="text-sm text-ink-soft">
                  {voo.name} · {voo.exchange}
                </p>
              </div>
              <span class="rounded-full bg-brick-50 px-3 py-1 text-xs font-semibold text-brick">Registrace v USA</span>
            </div>
            <p class="mt-4 flex items-center gap-2 text-sm font-semibold text-brick">
              <BaseIcon name="close" size={18} />
              Drobný investor z EU ho u brokera obvykle nekoupí
            </p>
          </div>
          <div class="flex justify-center" aria-hidden="true">
            <BaseIcon name="arrow-down" size={28} class="text-pine" />
          </div>
          <div class="card border-gain/40 p-6 ring-2 ring-mint">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-serif text-3xl text-pine">{vooUcits.primary}</p>
                <p class="text-sm text-ink-soft">
                  {vooUcits.name} · LSE, Xetra
                </p>
              </div>
              <span class="rounded-full bg-mint px-3 py-1 text-xs font-semibold text-gain">UCITS · Irsko</span>
            </div>
            <dl class="num mt-4 grid grid-cols-2 gap-3 text-sm">
              <div>
                <dt class="text-ink-soft">Index</dt>
                <dd class="font-semibold">S&amp;P 500</dd>
              </div>
              <div>
                <dt class="text-ink-soft">TER</dt>
                <dd class="font-semibold">{format.ter(vooUcits.ter)}</dd>
              </div>
            </dl>
            <p class="mt-4 flex items-center gap-2 text-sm font-semibold text-gain">
              <BaseIcon name="check" size={18} />
              Koupíte u evropských brokerů
            </p>
          </div>
          <p class="text-center text-sm text-ink-soft">+ dalších {etfs.length - 1} ETF z NYSE a jejich obdoby ({etfs.filter((e) => e.ticker !== voo.ticker).slice(0, 4).map((e) => e.ticker).join(', ')}…)</p>
        </figure>
      )
    }
  </div>
</section>
