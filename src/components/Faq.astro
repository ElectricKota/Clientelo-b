---
import { faq } from '../data/faq';
---

<section data-section="faq" aria-labelledby="faq-title" class="bg-sand/60 py-16 sm:py-24">
  <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
    <div>
      <p class="eyebrow">Časté otázky</p>
      <h2 id="faq-title" class="mt-3 text-3xl leading-tight sm:text-4xl">Na co se lidé ptají, než začnou</h2>
    </div>
    <div class="divide-y divide-line border-y border-line">
      {
        faq.map((item) => (
          <details class="group" name="faq">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 text-lg font-semibold text-pine [&::-webkit-details-marker]:hidden">
              {item.q}
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" class="shrink-0 transition-transform group-open:rotate-45">
                <path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </summary>
            <div class="pb-5 text-ink-soft">
              <p>{item.a}</p>
              {item.sources && (
                <p class="mt-2 flex flex-wrap gap-x-4 text-sm">
                  {item.sources.map((url) => (
                    <a href={url} class="link inline-flex min-h-6 items-center" rel="noopener" target="_blank">
                      Zdroj: {new URL(url).hostname.replace(/^www\./, '')}
                      <span class="sr-only"> (otevře se v novém okně)</span>
                    </a>
                  ))}
                </p>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
