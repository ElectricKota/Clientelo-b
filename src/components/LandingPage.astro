---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import TrustBar from './TrustBar.astro';
import FeeCalculator from './FeeCalculator.astro';
import EtfCompare from './EtfCompare.astro';
import GuideOffer from './GuideOffer.astro';
import Method from './Method.astro';
import Faq from './Faq.astro';
import StickyCta from './StickyCta.astro';
import { faq } from '../data/faq';
import { data, etfs } from '../data/etfs';
import { site } from '../site';

interface Props {
  variant: 'a' | 'b';
  title?: string;
  description?: string;
}
const { variant, title, description } = Astro.props;
const url = new URL('/', Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title ?? site.title,
    description: description ?? site.description,
    url,
    inLanguage: 'cs-CZ',
    dateModified: data.asOf,
    publisher: { '@type': 'Organization', name: site.brand, url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Porovnání ETF z NYSE a jejich UCITS alternativ',
    description: 'Poplatky (TER), velikost fondů, výnosy a evropské alternativy nejpopulárnějších ETF obchodovaných na NYSE.',
    url,
    dateModified: data.asOf,
    creator: { '@type': 'Organization', name: site.brand },
    isBasedOn: [...new Set(etfs.map((e) => e.sourceUrl))],
    license: 'https://creativecommons.org/licenses/by/4.0/',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base variant={variant} title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <a
    slot="header-cta"
    href="#formular"
    class="btn btn-secondary hidden min-h-11 px-5 py-2 text-sm sm:inline-flex"
    data-track="cta_click"
    data-placement="header"
    data-label="form">Stáhnout tahák zdarma</a
  >

  <Hero variant={variant} />
  <TrustBar />
  {
    variant === 'a' ? (
      <>
        <FeeCalculator />
        <EtfCompare />
      </>
    ) : (
      <>
        <EtfCompare />
        <FeeCalculator />
      </>
    )
  }
  <GuideOffer />
  <Method />
  <Faq />

  <StickyCta slot="after-footer" />
</Base>
