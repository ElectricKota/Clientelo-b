---
// Přehled obou verzí reklamy a toho, jak na ně navazuje první obrazovka stránky. Interní stránka (noindex).
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { ads, adUrl, targeting, campaign } from '../data/ads';
import { site } from '../site';
import aFeed from '../assets/reklamy/a-feed.png';
import aStory from '../assets/reklamy/a-story.png';
import bFeed from '../assets/reklamy/b-feed.png';
import bStory from '../assets/reklamy/b-story.png';
import lpA from '../assets/reklamy/lp-a.png';
import lpB from '../assets/reklamy/lp-b.png';

const images = {
  a: { feed: aFeed, story: aStory, lp: lpA },
  b: { feed: bFeed, story: bStory, lp: lpB },
};
const host = new URL(Astro.site!).host.toUpperCase();
---

<Base title={`Reklamy | ${site.brand}`} description="Dvě verze reklamy na Meta a jak na ně navazuje první obrazovka stránky." noindex>
  <section class="container-page pt-6 pb-10 sm:pt-12">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Kampaň {campaign.name}</p>
      <h1 class="mt-3 text-4xl leading-tight font-medium sm:text-6xl">Dvě verze reklamy a stránka, která na ně navazuje</h1>
      <p class="mt-5 text-lg text-ink-soft">
        Každá reklama vede na vlastní variantu stránky. První obrazovka opakuje slib reklamy: stejný nadpis, stejný vizuál a hned pod ním výčet toho, co
        návštěvník zdarma získá.
      </p>
    </div>

    <dl class="reveal mt-10 grid gap-x-8 gap-y-5 rounded-(--radius-card) border border-line bg-surface p-6 text-sm sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          ['Platforma', targeting.platform],
          ['Cíl kampaně', targeting.objective],
          ['Zařízení', targeting.device],
          ['Lokalita', targeting.geo],
          ['Věk', targeting.age],
          ['Zájmy', targeting.interests],
        ].map(([dt, dd]) => (
          <div>
            <dt class="font-semibold text-pine">{dt}</dt>
            <dd class="mt-1 text-ink-soft">{dd}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    ads.map((ad) => {
      const img = images[ad.id];
      const url = adUrl(ad, Astro.site!);
      return (
        <section class:list={['py-14 sm:py-20', ad.id === 'b' && 'bg-sand/60']} aria-labelledby={`ad-${ad.id}`}>
          <div class="container-page">
            <div class="reveal max-w-3xl">
              <p class="eyebrow">Reklama {ad.id.toUpperCase()}</p>
              <h2 id={`ad-${ad.id}`} class="mt-2 text-3xl leading-tight sm:text-5xl">
                {ad.name}
              </h2>
              <p class="mt-3 text-lg text-ink-soft">{ad.angle}</p>
            </div>

            <div class="mt-10 grid items-start gap-8 md:grid-cols-2 xl:grid-cols-[minmax(0,5fr)_minmax(0,3fr)_minmax(0,3fr)]">
              {/* Náhled příspěvku ve feedu (obecný vzhled sociální sítě) */}
              <figure class="reveal card overflow-hidden" aria-label={`Náhled reklamy ${ad.id.toUpperCase()} ve feedu`}>
                <div class="flex items-center gap-3 p-4">
                  <svg width="40" height="40" viewBox="0 0 32 32" aria-hidden="true">
                    <rect width="32" height="32" rx="16" fill="#0f3d36" />
                    <path d="M8 21.5 13.5 16l4 3.5L24 11" fill="none" stroke="#f7f4ee" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <div class="leading-tight">
                    <p class="font-semibold">{site.brand}</p>
                    <p class="text-xs text-ink-soft">Sponzorováno</p>
                  </div>
                </div>
                <p class="px-4 pb-4 text-[0.95rem] leading-relaxed whitespace-pre-line">{ad.primaryText}</p>
                <Image src={img.feed} alt={`Vizuál reklamy ${ad.id.toUpperCase()} ve formátu 4:5`} widths={[400, 640, 1080]} sizes="(min-width: 1280px) 540px, (min-width: 768px) 50vw, 100vw" class="w-full" loading="lazy" />
                <div class="flex items-center justify-between gap-4 bg-sand/70 p-4">
                  <div class="min-w-0">
                    <p class="truncate text-xs text-ink-soft">{host}</p>
                    <p class="truncate font-semibold">{ad.headline}</p>
                    <p class="truncate text-sm text-ink-soft">{ad.description}</p>
                  </div>
                  <span class="shrink-0 rounded-lg bg-line px-4 py-2 text-sm font-semibold">{ad.cta}</span>
                </div>
              </figure>

              <figure class="reveal" aria-label={`Reklama ${ad.id.toUpperCase()} ve formátu stories`}>
                <Image src={img.story} alt={`Vizuál reklamy ${ad.id.toUpperCase()} ve formátu 9:16 pro stories`} widths={[300, 540]} sizes="(min-width: 1280px) 320px, (min-width: 768px) 50vw, 100vw" class="mx-auto w-full max-w-xs rounded-[1.75rem] border border-line shadow-(--shadow-card)" loading="lazy" />
                <figcaption class="mt-3 text-center text-sm text-ink-soft">Stories a Reels, 1080 × 1920</figcaption>
              </figure>

              <figure class="reveal md:col-span-2 xl:col-span-1" aria-label={`První obrazovka stránky ${ad.landingPath} na mobilu`}>
                <div class="mx-auto w-full max-w-xs rounded-[2.25rem] border-[10px] border-ink bg-ink shadow-(--shadow-card)">
                  <Image src={img.lp} alt={`První obrazovka stránky ${ad.landingPath} na mobilu`} widths={[300, 600]} sizes="320px" class="w-full rounded-[1.6rem]" loading="lazy" />
                </div>
                <figcaption class="mt-3 text-center text-sm text-ink-soft">
                  Navazuje: <a class="link" href={ad.landingPath}>{ad.landingPath}</a>
                </figcaption>
              </figure>
            </div>

            <div class="mt-12 grid gap-10 lg:grid-cols-2">
              <div class="reveal">
                <h3 class="font-sans text-lg font-semibold">Jak navazuje první obrazovka</h3>
                <ul class="mt-4 space-y-3">
                  {ad.messageMatch.map((m) => (
                    <li class="flex gap-3">
                      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" class="mt-0.5 shrink-0">
                        <circle cx="10" cy="10" r="10" fill="#dcefe6" />
                        <path d="m6 10.5 2.5 2.5L14 7.5" fill="none" stroke="#23704f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      <span class="text-ink-soft">{m}</span>
                    </li>
                  ))}
                </ul>
                <h3 class="mt-8 font-sans text-lg font-semibold">Hypotéza</h3>
                <p class="mt-2 text-ink-soft">{ad.hypothesis}</p>
              </div>

              <div class="reveal">
                <h3 class="font-sans text-lg font-semibold">Texty a odkaz</h3>
                <dl class="mt-4 grid grid-cols-2 gap-4 text-sm">
                  <div class="col-span-2">
                    <dt class="text-ink-soft">Primární text</dt>
                    <dd class="mt-1 text-base whitespace-pre-line">{ad.primaryText}</dd>
                  </div>
                  <div>
                    <dt class="text-ink-soft">Nadpis</dt>
                    <dd class="mt-1 text-base font-semibold">{ad.headline}</dd>
                  </div>
                  <div>
                    <dt class="text-ink-soft">Popis</dt>
                    <dd class="mt-1 text-base">{ad.description}</dd>
                  </div>
                  <div class="col-span-2">
                    <dt class="text-ink-soft">Tlačítko</dt>
                    <dd class="mt-1 text-base">{ad.cta}</dd>
                  </div>
                  <div class="col-span-2">
                    <dt class="text-ink-soft">Cílová URL s UTM</dt>
                    <dd class="mt-1 rounded-xl bg-surface p-3 font-mono text-xs break-all">{url}</dd>
                  </div>
                </dl>
                <p class="mt-5 flex flex-wrap gap-3">
                  <a class="btn btn-secondary min-h-11 px-5 text-sm" href={img.feed.src} download={`reklama-${ad.id}-feed-1080x1350.png`}>
                    Stáhnout feed 4:5
                  </a>
                  <a class="btn btn-secondary min-h-11 px-5 text-sm" href={img.story.src} download={`reklama-${ad.id}-story-1080x1920.png`}>
                    Stáhnout stories 9:16
                  </a>
                </p>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }
</Base>
