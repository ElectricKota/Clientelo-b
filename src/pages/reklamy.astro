---
// Přehled obou verzí reklamy a toho, jak na ně navazuje první obrazovka stránky. Interní stránka (noindex).
import DefaultLayout from '~/layouts/DefaultLayout.astro';
import { ads, targeting, campaign } from '~/data/ads';
import AdShowcase from '~/components/ad/AdShowcase.astro';
import { appConfig } from '~/app.config';
import feedA from '~/assets/ads/a-feed.png';
import storyA from '~/assets/ads/a-story.png';
import feedB from '~/assets/ads/b-feed.png';
import storyB from '~/assets/ads/b-story.png';
import landingA from '~/assets/ads/lp-a.png';
import landingB from '~/assets/ads/lp-b.png';

const adImages = {
  a: { feed: feedA, story: storyA, landing: landingA },
  b: { feed: feedB, story: storyB, landing: landingB },
};
---

<DefaultLayout title={`Reklamy | ${appConfig.brand}`} description="Dvě verze reklamy na Meta a jak na ně navazuje první obrazovka stránky." noindex>
  <section class="container-page pt-6 pb-10 sm:pt-12">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Kampaň {campaign.name}</p>
      <h1 class="mt-3 text-4xl leading-tight font-medium sm:text-6xl">Dvě verze reklamy a stránka, která na ně navazuje</h1>
      <p class="mt-5 text-lg text-ink-soft">
        Každá reklama vede na vlastní variantu stránky. První obrazovka opakuje slib reklamy: stejný nadpis, stejný vizuál a hned pod ním výčet toho, co
        návštěvník zdarma získá.
      </p>
    </div>

    <dl class="reveal mt-10 grid gap-x-8 gap-y-5 rounded-(--radius-card) border border-line bg-surface p-6 text-sm sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          ['Platforma', targeting.platform],
          ['Cíl kampaně', targeting.objective],
          ['Zařízení', targeting.device],
          ['Lokalita', targeting.geo],
          ['Věk', targeting.age],
          ['Zájmy', targeting.interests],
        ].map(([term, description]) => (
          <div>
            <dt class="font-semibold text-pine">{term}</dt>
            <dd class="mt-1 text-ink-soft">{description}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {ads.map((ad) => <AdShowcase ad={ad} images={adImages[ad.id]} />)}
</DefaultLayout>
