---
// Předlohy reklamních vizuálů. `npm run og` je vyfotí do src/assets/reklamy/*.png
// (feed 1080×1350, stories 1080×1920 s bezpečnými zónami nahoře 250 px a dole 340 px).
//
// A „Účtenka“: hook = konkrétní číslo ztráty (averze ke ztrátě) + účtenka jako vizuální vybočení z feedu.
// B „Chat“: nativně vypadající konverzace, hook = frustrace, kterou cílovka zná („broker mi VOO nenajde“).
import { Font } from 'astro:assets';
import '../../styles/global.css';
import Receipt from '../../components/Receipt.astro';
import { etfs, fmt, feeCost, calcDefaults } from '../../data/etfs';
import { site } from '../../site';

export function getStaticPaths() {
  return ['a-feed', 'a-story', 'b-feed', 'b-story'].map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const [variant, format] = id.split('-') as ['a' | 'b', 'feed' | 'story'];
const story = format === 'story';
const width = 1080;
const height = story ? 1920 : 1350;

const base = { initial: calcDefaults.initial, monthly: calcDefaults.monthly, years: calcDefaults.years, annualReturn: calcDefaults.annualReturn };
const loss = feeCost({ ...base, ter: calcDefaults.customTer });
const vuaa = etfs.find((e) => e.ticker === 'VOO')!.ucits[0];

type Bubble = { from: 'them' | 'me'; text: string } | { from: 'me'; card: 'vuaa' | 'link' } | { from: 'them'; typing: true };
const chat: Bubble[] = [
  { from: 'them', text: 'Proč mi broker nenajde VOO? 🤨' },
  { from: 'me', text: 'Z EU ho jako drobnej investor nekoupíš. Regulace PRIIPs.' },
  { from: 'me', text: 'Kup VUAA. Stejnej S&P 500, jen evropská verze 👇' },
  { from: 'me', card: 'vuaa' },
  { from: 'them', text: 'A SCHD? VT? 😅' },
  { from: 'me', text: 'Tady máš tahák na všech 10 👇' },
  { from: 'them', typing: true },
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Reklama {id}</title>
    <Font cssVariable="--font-geist" />
    <Font cssVariable="--font-newsreader" />
    <style is:global define:vars={{ w: `${width}px`, h: `${height}px` }}>
      html,
      body {
        margin: 0;
        width: var(--w);
        height: var(--h);
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    {
      variant === 'a' ? (
        <div class:list={['relative flex h-full flex-col overflow-hidden bg-pine text-white', story ? 'px-[84px] pt-[250px] pb-[340px]' : 'px-[76px] pt-[64px] pb-[56px]']}>
          <div class="absolute -top-56 -left-40 size-[760px] rounded-full bg-[#1d5c51] opacity-60 blur-3xl" aria-hidden="true" />
          <div class="absolute -right-48 bottom-24 size-[620px] rounded-full bg-brick opacity-25 blur-3xl" aria-hidden="true" />

          <h1 class="relative font-serif leading-[0.95] font-medium tracking-tight text-white">
            <span class={`num block text-[#f4b393] ${story ? 'text-[168px]' : 'text-[150px]'}`}>{fmt.czk(loss)}</span>
            <span class={`mt-4 block ${story ? 'text-[80px]' : 'text-[66px]'} leading-[1.05]`}>
              za {base.years} let. <em class="text-[#f4b393]">A ani o tom nevíte.</em>
            </span>
          </h1>

          <div class={`relative mx-auto w-full ${story ? 'mt-20 max-w-[900px]' : 'mt-12 max-w-[900px]'}`}>
            <Receipt size={story ? '32px' : '30px'} class="-rotate-2" />
          </div>

          <footer class="relative mt-auto flex items-end justify-between gap-8">
            <div>
              <p class="flex items-center gap-3 font-serif text-[34px] font-semibold">
                <svg width="44" height="44" viewBox="0 0 32 32" aria-hidden="true">
                  <rect width="32" height="32" rx="8" fill="#f7f4ee" />
                  <path d="M8 21.5 13.5 16l4 3.5L24 11" fill="none" stroke="#0f3d36" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="24" cy="11" r="2.4" fill="#e9895c" />
                </svg>
                {site.brand}
              </p>
              <p class="mt-3 max-w-[520px] text-[17px] leading-snug text-white/60">Modelový výpočet, TER dle emitentů. Nejde o investiční doporučení.</p>
            </div>
            <span class="flex shrink-0 items-center gap-4 rounded-full bg-brick py-5 pr-6 pl-9 text-[32px] font-semibold">
              Spočítat svou účtenku
              <svg width="34" height="34" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </footer>
        </div>
      ) : (
        <div class:list={['relative flex h-full flex-col bg-[#efeae2] text-ink', story ? 'pt-[200px] pb-[300px]' : '']}>
          {/* Hlavička konverzace (obecný vzhled chatu, bez značky konkrétní aplikace) */}
          <header class={`flex items-center gap-6 border-b border-black/5 bg-white/80 px-14 ${story ? 'py-8' : 'py-6'}`}>
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#10302b" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
              <path d="m15 5-7 7 7 7" />
            </svg>
            <span class="grid size-[84px] place-items-center rounded-full bg-[#c9d8d2] text-[36px] font-semibold text-pine">H</span>
            <div class="leading-tight">
              <p class="text-[36px] font-semibold">Honza</p>
              <p class="text-[26px] text-ink-soft">online</p>
            </div>
          </header>

          <ul class={`flex min-h-0 flex-1 flex-col overflow-hidden ${story ? 'gap-5 px-14 pt-12' : 'gap-4 px-12 pt-8'}`}>
            {chat.map((b) =>
              'typing' in b ? (
                <li class="flex justify-start" aria-hidden="true">
                  <span class="flex gap-2.5 rounded-[38px] rounded-tl-lg bg-white px-8 py-7">
                    <span class="size-4 rounded-full bg-ink/30" />
                    <span class="size-4 rounded-full bg-ink/45" />
                    <span class="size-4 rounded-full bg-ink/30" />
                  </span>
                </li>
              ) : 'card' in b ? (
                <li class="flex justify-end">
                  {b.card === 'vuaa' ? (
                    <div class={`w-[640px] rounded-[34px] rounded-tr-lg bg-white shadow-[0_2px_0_rgb(0_0_0/0.06)] ${story ? 'p-7' : 'px-7 py-6'}`}>
                      <div class="flex items-start justify-between">
                        <p class={`font-serif leading-none text-pine ${story ? 'text-[76px]' : 'text-[64px]'}`}>{vuaa.primary}</p>
                        <span class="rounded-full bg-mint px-5 py-1.5 text-[24px] font-semibold text-gain">UCITS</span>
                      </div>
                      <p class="mt-3 text-[25px] leading-snug text-ink-soft">{vuaa.name}</p>
                      <p class="num mt-4 flex gap-3 text-[25px]">
                        <span class="rounded-full bg-sand px-4 py-1">S&amp;P 500</span>
                        <span class="rounded-full bg-sand px-4 py-1">TER {fmt.ter(vuaa.ter)}</span>
                      </p>
                    </div>
                  ) : (
                    <div class="w-[680px] overflow-hidden rounded-[34px] rounded-tr-lg bg-[#d6eadf]">
                      <div class="bg-pine px-8 py-7 text-white">
                        <p class="font-serif text-[46px] leading-tight">
                          VOO si z Česka nekoupíte. <em class="text-[#f4b393]">Tohle ano.</em>
                        </p>
                      </div>
                      <p class="px-8 py-5 text-[25px] text-ink-soft">ETF tahák · 10 ETF z NYSE a jejich evropská dvojčata</p>
                    </div>
                  )}
                </li>
              ) : (
                <li class={`flex ${b.from === 'me' ? 'justify-end' : 'justify-start'}`}>
                  <p
                    class:list={[
                      'max-w-[780px] px-9 leading-snug shadow-[0_2px_0_rgb(0_0_0/0.06)]',
                      story ? 'py-6 text-[38px]' : 'py-5 text-[37px]',
                      b.from === 'me' ? 'rounded-[38px] rounded-tr-lg bg-[#d6eadf]' : 'rounded-[38px] rounded-tl-lg bg-white',
                    ]}
                  >
                    {b.text}
                  </p>
                </li>
              ),
            )}
          </ul>

          <footer class={`flex shrink-0 items-center justify-between gap-6 bg-pine text-white ${story ? 'mx-14 rounded-[48px] px-10 py-8' : 'mt-6 px-12 py-8'}`}>
            <div>
              <p class="font-serif text-[40px] leading-tight">Co koupit místo VOO?</p>
              <p class="mt-1 text-[19px] text-white/60">Ilustrační konverzace. Nejde o investiční doporučení.</p>
            </div>
            <span class="grid size-[96px] shrink-0 place-items-center rounded-full bg-brick">
              <svg width="42" height="42" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </footer>
        </div>
      )
    }
  </body>
</html>
