---
// Předlohy reklamních vizuálů. `npm run og` je vyfotí do src/assets/reklamy/*.png
// (feed 1080×1350, stories 1080×1920). Vizuál záměrně opakuje hero dané varianty stránky.
import { Font } from 'astro:assets';
import '../../styles/global.css';
import { data, etfs, fmt, feeCost, calcDefaults } from '../../data/etfs';
import { site } from '../../site';

export function getStaticPaths() {
  return ['a-feed', 'a-story', 'b-feed', 'b-story'].map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const [variant, format] = id.split('-') as ['a' | 'b', 'feed' | 'story'];
const story = format === 'story';
const width = 1080;
const height = story ? 1920 : 1350;

const byTicker = (t: string) => etfs.find((e) => e.ticker === t)!;
const spy = byTicker('SPY');
const voo = byTicker('VOO');
const vuaa = voo.ucits[0];
const base = { initial: calcDefaults.initial, monthly: calcDefaults.monthly, years: calcDefaults.years, annualReturn: calcDefaults.annualReturn };
const rows = [
  { label: spy.ticker, ter: spy.ter, tone: 'bg-pine' },
  { label: voo.ticker, ter: voo.ter, tone: 'bg-pine' },
  { label: vuaa.primary, ter: vuaa.ter, tone: 'bg-gain' },
  { label: 'Fond za 1,5 %', ter: calcDefaults.customTer, tone: 'bg-brick' },
].map((r) => ({ ...r, cost: feeCost({ ...base, ter: r.ter }) }));
const max = Math.max(...rows.map((r) => r.cost));
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Reklama {id}</title>
    <Font cssVariable="--font-geist" />
    <Font cssVariable="--font-newsreader" />
    <style is:global define:vars={{ w: `${width}px`, h: `${height}px` }}>
      html,
      body {
        margin: 0;
        width: var(--w);
        height: var(--h);
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <div
      class:list={['relative flex h-full flex-col bg-paper text-ink', story ? 'px-[88px] pt-[250px] pb-[340px]' : 'px-[80px] pt-[60px] pb-[52px]']}
    >
      <!-- jemná dekorace: velký rozostřený kruh v barvě značky -->
      <div class="absolute -top-40 -right-40 size-[620px] rounded-full bg-mint opacity-70 blur-3xl" aria-hidden="true"></div>

      <header class="relative flex items-center justify-between">
        <div class="flex items-center gap-4 font-serif text-[40px] font-semibold text-pine">
          <svg width="56" height="56" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="#0f3d36"></rect>
            <path d="M8 21.5 13.5 16l4 3.5L24 11" fill="none" stroke="#f7f4ee" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
            <circle cx="24" cy="11" r="2.4" fill="#e9895c"></circle>
          </svg>
          {site.brand}
        </div>
        <span class="text-[26px] text-ink-soft">data k {fmt.date(data.asOf)}</span>
      </header>

      {
        variant === 'a' ? (
          <>
            <p class={`relative font-semibold tracking-wide text-brick uppercase ${story ? 'mt-24 text-[36px]' : 'mt-10 text-[30px]'}`}>
              Poplatky za {calcDefaults.years} let
            </p>
            <h1 class={`relative mt-5 font-serif leading-[1.0] font-medium tracking-tight ${story ? 'text-[132px]' : 'text-[100px]'}`}>
              Stejný index. <em class="text-brick">Jiný poplatek.</em>
            </h1>

            <div class={`card relative ${story ? 'mt-20 p-14' : 'mt-9 px-12 py-9'}`}>
              <p class="text-[26px] text-ink-soft">
                {fmt.czk(base.initial)} + {fmt.czk(base.monthly)} měsíčně, {base.annualReturn} % ročně
              </p>
              <ul class={story ? 'mt-10 space-y-10' : 'mt-5 space-y-5'}>
                {rows.map((r) => (
                  <li>
                    <div class="flex items-baseline justify-between">
                      <span class="text-[36px] font-semibold">
                        {r.label} <span class="num text-[26px] font-normal text-ink-soft">TER {fmt.ter(r.ter)}</span>
                      </span>
                      <span class="num font-serif text-[48px] text-pine">{fmt.czk(r.cost)}</span>
                    </div>
                    <div class="mt-3 h-4 rounded-full bg-sand">
                      <div class={`h-full rounded-full ${r.tone}`} style={`width:${Math.max((r.cost / max) * 100, 2).toFixed(1)}%`} />
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </>
        ) : (
          <>
            <h1 class={`relative font-serif leading-[1.0] font-medium tracking-tight ${story ? 'mt-24 text-[132px]' : 'mt-12 text-[100px]'}`}>
              VOO si z Česka nekoupíte. <em class="text-brick">Tohle ano.</em>
            </h1>

            <div class={`relative ${story ? 'mt-20' : 'mt-10'}`}>
              <div class="flex items-center gap-6 rounded-full border-2 border-line bg-surface px-10 py-7 text-[38px]">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#4a5b57" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m20 20-4-4" />
                </svg>
                <span class="font-semibold">VOO</span>
                <span class="ml-auto flex items-center gap-3 rounded-full bg-brick-50 px-6 py-2 text-[28px] font-semibold text-brick">
                  <svg width="28" height="28" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="m6 6 8 8m0-8-8 8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                  </svg>
                  Nenalezeno
                </span>
              </div>

              <div class="flex justify-center py-6" aria-hidden="true">
                <svg width="56" height="56" viewBox="0 0 24 24" class="text-pine">
                  <path d="M12 4v16m0 0-6-6m6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>

              <div class={`card ring-4 ring-mint ${story ? "p-12" : "px-12 py-10"}`}>
                <div class="flex items-start justify-between gap-6">
                  <div>
                    <p class="font-serif text-[88px] leading-none text-pine">{vuaa.primary}</p>
                    <p class="mt-4 text-[28px] text-ink-soft">{vuaa.name}</p>
                  </div>
                  <span class="rounded-full bg-mint px-6 py-2 text-[26px] font-semibold text-gain">UCITS</span>
                </div>
                <div class="num mt-8 flex gap-4 text-[28px]">
                  <span class="rounded-full bg-sand px-6 py-2">S&amp;P 500</span>
                  <span class="rounded-full bg-sand px-6 py-2">TER {fmt.ter(vuaa.ter)}</span>
                </div>
                <p class="mt-8 flex items-center gap-3 text-[32px] font-semibold text-gain">
                  <svg width="36" height="36" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="m5 10.5 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  Koupíte u evropských brokerů
                </p>
              </div>
              <p class={`text-center text-[30px] text-ink-soft ${story ? "mt-8" : "mt-6"}`}>+ dalších {etfs.length - 1} ETF z NYSE a jejich evropská dvojčata</p>
            </div>
          </>
        )
      }

      <footer class={`relative mt-auto ${story ? "" : "pt-8"}`}>
        <div class={`flex items-center justify-between gap-8 rounded-full bg-pine pr-4 pl-12 text-white ${story ? 'py-4' : 'py-3'}`}>
          <span class="text-[34px] font-semibold">{variant === 'a' ? 'Spočítejte si svůj rozdíl' : 'Zjistěte, co koupit místo VOO'}</span>
          <span class="grid size-[88px] place-items-center rounded-full bg-brick">
            <svg width="40" height="40" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </div>
        <p class="mt-4 text-[19px] leading-snug text-ink-soft">
          {
            variant === 'a'
              ? 'Modelový výpočet, poplatky fondů (TER) dle emitentů. Minulé ani modelové výnosy nejsou zárukou budoucích. Nejde o investiční doporučení.'
              : 'Ilustrační vyhledávání. Drobní investoři z EU obvykle nemohou kupovat ETF registrovaná v USA (PRIIPs). Nejde o investiční doporučení.'
          }
        </p>
      </footer>
    </div>
  </body>
</html>
