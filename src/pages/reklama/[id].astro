---
// Předlohy reklamních vizuálů. `npm run og` je vyfotí do src/assets/ads/*.png
// (feed 1080×1350, stories 1080×1920 s bezpečnými zónami nahoře 250 px a dole 340 px).
import RenderLayout from '~/layouts/RenderLayout.astro';
import AdCreativeReceipt from '~/components/ad/AdCreativeReceipt.astro';
import AdCreativeChat from '~/components/ad/AdCreativeChat.astro';

export function getStaticPaths() {
  return ['a-feed', 'a-story', 'b-feed', 'b-story'].map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const [variant, placement] = id.split('-') as ['a' | 'b', 'feed' | 'story'];
const isStory = placement === 'story';
---

<RenderLayout title={`Reklama ${id}`} width={1080} height={isStory ? 1920 : 1350}>
  {variant === 'a' ? <AdCreativeReceipt isStory={isStory} /> : <AdCreativeChat isStory={isStory} />}
</RenderLayout>
