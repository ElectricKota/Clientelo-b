---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { site } from '../site';
import ConsentBar from '../components/ConsentBar.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  /** Kanonická cesta (např. "/"), pokud se liší od aktuální URL. */
  canonicalPath?: string;
  noindex?: boolean;
  /** Varianta stránky pro A/B a navázání na reklamu. */
  variant?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title = site.title,
  description = site.description,
  canonicalPath,
  noindex = false,
  variant = 'a',
  jsonLd = [],
} = Astro.props;

// Build ve formátu `file` vrací /voo.html, Vercel (cleanUrls) ale servíruje /voo.
const cleanPath = (canonicalPath ?? Astro.url.pathname).replace(/index\.html$/, '').replace(/\.html$/, '');
const canonical = new URL(cleanPath, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const hasTrackers = Boolean(site.analytics.gaId || site.analytics.metaPixelId);
---

<!doctype html>
<html lang="cs" data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0f3d36" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // Reveal animace jen tam, kde má smysl. Pojistka: když se skript nenačte, obsah se po 3 s ukáže.
      (function (d) {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('js-reveal');
        setTimeout(function () {
          if (!window.__revealReady) d.classList.remove('js-reveal');
        }, 3000);
      })(document.documentElement);
    </script>

    <Font cssVariable="--font-geist" preload={[{ subset: 'latin', style: 'normal' }]} />
    <Font cssVariable="--font-newsreader" />

    {
      site.analytics.gaId && (
        <script is:inline define:vars={{ gaId: site.analytics.gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          window.gtag = gtag;
          // Consent Mode v2: do souhlasu bez cookies, jen anonymní pingy.
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            wait_for_update: 500,
          });
          try {
            if (localStorage.getItem('consent') === 'granted') {
              gtag('consent', 'update', {
                ad_storage: 'granted',
                ad_user_data: 'granted',
                ad_personalization: 'granted',
                analytics_storage: 'granted',
              });
            }
          } catch {}
          gtag('js', new Date());
          gtag('config', gaId, { send_page_view: true });
          window.__gaId = gaId;
        </script>
      )
    }

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="min-h-dvh">
    <a href="#obsah" class="sr-only-focusable fixed top-3 left-3 z-50 rounded-full bg-pine px-5 py-3 font-semibold text-white">
      Přeskočit na obsah
    </a>

    <header class="container-page flex items-center justify-between gap-4 py-4 sm:py-6">
      <a href="/" class="flex items-center gap-2 rounded-md font-serif text-xl font-semibold text-pine no-underline" aria-label={`${site.brand}, úvodní stránka`}>
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 32 32">
          <rect width="32" height="32" rx="8" fill="#0f3d36"></rect>
          <path d="M8 21.5 13.5 16l4 3.5L24 11" fill="none" stroke="#f7f4ee" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
          <circle cx="24" cy="11" r="2.4" fill="#e9895c"></circle>
        </svg>
        {site.brand}
      </a>
      <slot name="header-cta" />
    </header>

    <main id="obsah" tabindex="-1" class="outline-none">
      <slot />
    </main>

    <SiteFooter />
    <slot name="after-footer" />
    {hasTrackers && <ConsentBar />}

    <script>
      import '../scripts/reveal';
      import '../scripts/track';
    </script>
  </body>
</html>
